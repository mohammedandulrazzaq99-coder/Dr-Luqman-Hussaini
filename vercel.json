{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "^/images/(.*)",
      "dest": "/images/$1"
    },
    {
      "src": "^/animations\\.(css|js)",
      "dest": "/animations.$1"
    },
    {
      "src": "^/about$",
      "dest": "/about.html"
    },
    {
      "src": "^/expertise$",
      "dest": "/expertise.html"
    },
    {
      "src": "^/journey$",
      "dest": "/journey.html"
    },
    {
      "src": "^/research$",
      "dest": "/research.html"
    },
    {
      "src": "^/speaking$",
      "dest": "/speaking.html"
    },
    {
      "src": "^/media$",
      "dest": "/media.html"
    },
    {
      "src": "^/credentials$",
      "dest": "/credentials.html"
    },
    {
      "src": "^/inquiry$",
      "dest": "/inquiry.html"
    },
    {
      "src": "^/(.*)\\.html$",
      "dest": "/$1.html"
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}